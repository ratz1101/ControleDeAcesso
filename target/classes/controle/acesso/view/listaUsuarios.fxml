<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controle.acesso.view.ListaUsuariosController">
    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
    </padding>
    <children>
        <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Usuários Cadastrados" />
        <Label text="Consulte os usuários armazenados no banco de dados." />
        <TableView fx:id="tblUsuarios" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="55.0" text="ID" />
                <TableColumn fx:id="colNome" prefWidth="170.0" text="Nome" />
                <TableColumn fx:id="colCpf" prefWidth="125.0" text="CPF" />
                <TableColumn fx:id="colCargo" prefWidth="120.0" text="Cargo" />
                <TableColumn fx:id="colEmail" prefWidth="210.0" text="E-mail" />
                <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
                <TableColumn fx:id="colData" prefWidth="145.0" text="Data Cadastro" />
            </columns>
        </TableView>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <Button onAction="#btnLimparAction" text="Limpar Tabela" />
            <Button defaultButton="true" onAction="#btnListarAction" text="Listar / Atualizar" />
        </HBox>
    </children>
</VBox>
