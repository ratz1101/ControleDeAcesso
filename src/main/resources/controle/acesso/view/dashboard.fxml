<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controle.acesso.view.DashboardController">
    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
    </padding>
    <children>
        <VBox spacing="2.0">
            <children>
                <Label styleClass="titulo-pagina" text="Dashboard" />
                <Label styleClass="subtitulo-pagina" text="Visão geral do sistema de controle de acesso." />
            </children>
        </VBox>

        <HBox spacing="16.0">
            <children>
                <VBox styleClass="card, card-azul" spacing="8.0" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <children>
                        <Label styleClass="card-rotulo" text="USUÁRIOS ATIVOS" />
                        <Label fx:id="lblAtivos" styleClass="card-valor" text="0" />
                    </children>
                </VBox>
                <VBox styleClass="card, card-vermelho" spacing="8.0" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <children>
                        <Label styleClass="card-rotulo" text="USUÁRIOS BLOQUEADOS" />
                        <Label fx:id="lblBloqueados" styleClass="card-valor" text="0" />
                    </children>
                </VBox>
                <VBox styleClass="card, card-verde" spacing="8.0" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <children>
                        <Label styleClass="card-rotulo" text="ACESSOS AUTORIZADOS HOJE" />
                        <Label fx:id="lblAcessosHoje" styleClass="card-valor" text="0" />
                    </children>
                </VBox>
                <VBox styleClass="card, card-laranja" spacing="8.0" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <children>
                        <Label styleClass="card-rotulo" text="ACESSOS NEGADOS HOJE" />
                        <Label fx:id="lblNegadosHoje" styleClass="card-valor" text="0" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <HBox spacing="10.0">
            <children>
                <Button styleClass="button-primario" onAction="#btnCadastrarAction" text="+ Cadastrar Usuário" />
                <Button onAction="#btnHistoricoAction" text="Ver Histórico" />
                <Button onAction="#btnRelatorioAction" text="Gerar Relatório" />
                <Button styleClass="button-sutil" onAction="#btnAtualizarAction" text="Atualizar" />
            </children>
        </HBox>

        <VBox styleClass="painel" spacing="12.0" VBox.vgrow="ALWAYS">
            <children>
                <Label style="-fx-font-size: 14px; -fx-font-weight: 700;" text="Últimos Acessos" />
                <TableView fx:id="tblUltimos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colUsuario" prefWidth="200.0" text="Usuário" />
                        <TableColumn fx:id="colTipo" prefWidth="100.0" text="Tipo" />
                        <TableColumn fx:id="colResultado" prefWidth="130.0" text="Resultado" />
                        <TableColumn fx:id="colData" prefWidth="150.0" text="Data/Hora" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>
