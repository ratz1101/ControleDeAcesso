<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controle.acesso.view.ListaUsuariosController">
    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
    </padding>
    <children>
        <VBox spacing="2.0">
            <children>
                <Label styleClass="titulo-pagina" text="Usuários Cadastrados" />
                <Label styleClass="subtitulo-pagina" text="Consulte, edite ou remova os usuários do sistema." />
            </children>
        </VBox>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <TextField fx:id="txtBusca" promptText="Buscar por nome, CPF ou e-mail" HBox.hgrow="ALWAYS" />
                <Button onAction="#btnBuscarAction" text="Buscar" />
                <Button styleClass="button-sutil" onAction="#btnListarAction" text="Limpar Busca" />
            </children>
        </HBox>

        <TableView fx:id="tblUsuarios" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colNome" prefWidth="160.0" text="Nome" />
                <TableColumn fx:id="colCpf" prefWidth="115.0" text="CPF" />
                <TableColumn fx:id="colCargo" prefWidth="100.0" text="Cargo" />
                <TableColumn fx:id="colEmail" prefWidth="190.0" text="E-mail" />
                <TableColumn fx:id="colStatus" prefWidth="95.0" text="Status" />
                <TableColumn fx:id="colData" prefWidth="130.0" text="Cadastro" />
                <TableColumn fx:id="colAcoes" prefWidth="140.0" text="Ações" />
            </columns>
        </TableView>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button onAction="#btnLimparAction" text="Limpar Tabela" />
                <Button styleClass="button-primario" defaultButton="true" onAction="#btnListarAction" text="Atualizar Lista" />
            </children>
        </HBox>
    </children>
</VBox>
