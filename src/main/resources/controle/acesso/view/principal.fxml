<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane fx:id="painelPrincipal" prefHeight="640.0" prefWidth="960.0"
            styleClass="tela-principal"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controle.acesso.view.PrincipalController">
    <top>
        <MenuBar BorderPane.alignment="CENTER">
            <menus>
                <Menu text="Início">
                    <items>
                        <MenuItem onAction="#abrirDashboard" text="Dashboard" />
                        <SeparatorMenuItem />
                        <MenuItem onAction="#sair" text="Sair" />
                    </items>
                </Menu>
                <Menu text="Usuários">
                    <items>
                        <MenuItem onAction="#abrirCadastroUsuario" text="Cadastrar Usuário" />
                        <MenuItem onAction="#abrirListaUsuarios" text="Listar / Editar Usuários" />
                    </items>
                </Menu>
                <Menu text="Relatórios">
                    <items>
                        <MenuItem onAction="#abrirHistorico" text="Histórico de Acessos" />
                        <MenuItem onAction="#abrirRelatorioFrequencia" text="Relatório de Frequência" />
                    </items>
                </Menu>
                <Menu text="Ajuda">
                    <items>
                        <MenuItem onAction="#abrirSobre" text="Sobre" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>
    <center>
        <Label fx:id="lblBoasVindas"
               styleClass="titulo-boas-vindas"
               text="Bem-vindo!"
               BorderPane.alignment="CENTER"
               visible="false"
               managed="false" />
    </center>
</BorderPane>
