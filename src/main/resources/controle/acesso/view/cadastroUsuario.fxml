<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controle.acesso.view.CadastroUsuarioController">
    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
    </padding>
    <children>
        <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Cadastro de Usuário" />
        <Label text="Preencha os dados do funcionário ou professor." />
        <GridPane hgap="12.0" vgap="12.0">
            <columnConstraints>
                <ColumnConstraints hgrow="NEVER" minWidth="90.0" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <children>
                <Label text="Nome *" />
                <TextField fx:id="txtNome" promptText="Nome completo" GridPane.columnIndex="1" />
                <Label text="CPF *" GridPane.rowIndex="1" />
                <TextField fx:id="txtCpf" promptText="000.000.000-00" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label text="Cargo *" GridPane.rowIndex="2" />
                <ComboBox fx:id="cmbCargo" promptText="Professor, Administrativo..." GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label text="E-mail *" GridPane.rowIndex="3" />
                <TextField fx:id="txtEmail" promptText="email@exemplo.com" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                <Label text="Senha *" GridPane.rowIndex="4" />
                <PasswordField fx:id="txtSenha" promptText="Senha de acesso" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                <Label text="Status *" GridPane.rowIndex="5" />
                <ComboBox fx:id="cmbStatus" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            </children>
        </GridPane>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <Button onAction="#btnLimparAction" text="Limpar" />
            <Button defaultButton="true" onAction="#btnCadastrarAction" text="Cadastrar" />
        </HBox>
        <Label style="-fx-font-size: 11px;" text="* Campos obrigatórios" />
    </children>
</VBox>
