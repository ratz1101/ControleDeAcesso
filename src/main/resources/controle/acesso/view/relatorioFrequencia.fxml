<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controle.acesso.view.RelatorioFrequenciaController">
    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
    </padding>
    <children>
        <VBox spacing="2.0">
            <children>
                <Label styleClass="titulo-pagina" text="Relatório de Frequência" />
                <Label styleClass="subtitulo-pagina" text="Totais de entradas, saídas e dias com acesso por usuário, em um período." />
            </children>
        </VBox>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label text="De:" />
                <DatePicker fx:id="dtInicio" prefWidth="140.0" />
                <Label text="Até:" />
                <DatePicker fx:id="dtFim" prefWidth="140.0" />
                <Button styleClass="button-primario" defaultButton="true" onAction="#btnGerarRelatorioAction" text="Gerar Relatório" />
            </children>
        </HBox>

        <TableView fx:id="tblFrequencia" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNome" prefWidth="180.0" text="Nome" />
                <TableColumn fx:id="colCargo" prefWidth="120.0" text="Cargo" />
                <TableColumn fx:id="colDias" prefWidth="110.0" text="Dias com Acesso" />
                <TableColumn fx:id="colEntradas" prefWidth="90.0" text="Entradas" />
                <TableColumn fx:id="colSaidas" prefWidth="90.0" text="Saídas" />
                <TableColumn fx:id="colNegados" prefWidth="90.0" text="Negados" />
            </columns>
        </TableView>

        <Label fx:id="lblResumo" styleClass="subtitulo-pagina" />
    </children>
</VBox>
